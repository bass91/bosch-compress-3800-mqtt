BOSCH_HOST=192.168.1.50
# Use Home Assistant's bosch access_key here, not the sticker token.
BOSCH_ACCESS_TOKEN=replace_with_home_assistant_access_key
# Only set this if you use the sticker token instead of access_key.
BOSCH_PASSWORD=

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=bosch
MQTT_PASSWORD=replace_with_mqtt_password
MQTT_CLIENT_ID=bosch-bridge
MQTT_TOPIC_PREFIX=bosch
HA_DISCOVERY_PREFIX=homeassistant

BOSCH_TIMEOUT=10
BOSCH_LIVE_INTERVAL=30
BOSCH_RECORDINGS_INTERVAL=3600
LOG_LEVEL=INFO
